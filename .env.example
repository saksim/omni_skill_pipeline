# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OMNI_OPENAI_LLM_MODEL=gpt-4.1
OMNI_OPENAI_VISION_MODEL=gpt-4.1-mini
OMNI_OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OMNI_OPENAI_TIMEOUT_SECONDS=60
OMNI_OPENAI_RETRY_MAX_ATTEMPTS=3
OMNI_OPENAI_RETRY_BASE_DELAY_SECONDS=0.5
OMNI_OPENAI_CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=3
OMNI_OPENAI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
OMNI_OPENAI_FAILURE_BUDGET_MAX_FAILURES=6
OMNI_OPENAI_FAILURE_BUDGET_WINDOW_SECONDS=60
OMNI_TRANSCRIPTION_LANGUAGE=

# API
OMNI_API_KEY=
OMNI_RATE_LIMIT_REQUESTS=0
OMNI_RATE_LIMIT_WINDOW_SECONDS=60
OMNI_TENANT_ACCESS_JSON=
OMNI_TENANT_ACCESS_FILE=
OMNI_LOG_LEVEL=INFO
OMNI_LOG_FORMAT=json

# Media
OMNI_FFMPEG_BIN=ffmpeg
OMNI_FFPROBE_BIN=ffprobe
OMNI_TESSERACT_BIN=tesseract
OMNI_TESSERACT_LANGUAGES=eng+chi_sim
OMNI_TMP_MEDIA_ROOT=.tmp_omni_media
OMNI_TMP_MEDIA_RETENTION_HOURS=24

# Video sampling
OMNI_KEYFRAME_INTERVAL_SECONDS=8
OMNI_MAX_KEYFRAMES=6
OMNI_VIDEO_SCENE_THRESHOLD=0.32
OMNI_VIDEO_FRAME_DEDUPE_DISTANCE=5

# Behavior
OMNI_PREFER_LLM_COMPOSER=true
OMNI_CONTROLLED_TRIAL_REVIEW_MODE=false
OMNI_CONTROLLED_TRIAL_REVIEW_REASON_CODE=controlled_trial_requires_review
OMNI_PORTABLE_SKILL_MARKDOWN_LINE_LIMIT=220

# Postgres integration tests (optional)
OMNI_TEST_POSTGRES_DSN=

# Artifact repository mode (GL-06)
# file | postgres | dual_write
OMNI_ARTIFACT_REPOSITORY_MODE=file
# Required when mode=postgres or mode=dual_write
OMNI_POSTGRES_REPOSITORY_DSN=
# Only for mode=dual_write
OMNI_DUAL_WRITE_CONTINUE_ON_SECONDARY_ERROR=true
OMNI_DUAL_WRITE_SECONDARY_PREFIX=secondary_
