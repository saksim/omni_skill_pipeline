# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OMNI_OPENAI_LLM_MODEL=gpt-4.1
OMNI_OPENAI_VISION_MODEL=gpt-4.1-mini
OMNI_OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OMNI_TRANSCRIPTION_LANGUAGE=

# Media
OMNI_FFMPEG_BIN=ffmpeg
OMNI_FFPROBE_BIN=ffprobe
OMNI_TESSERACT_BIN=tesseract
OMNI_TESSERACT_LANGUAGES=eng+chi_sim

# Video sampling
OMNI_KEYFRAME_INTERVAL_SECONDS=8
OMNI_MAX_KEYFRAMES=6
OMNI_VIDEO_SCENE_THRESHOLD=0.32
OMNI_VIDEO_FRAME_DEDUPE_DISTANCE=5

# Behavior
OMNI_PREFER_LLM_COMPOSER=true
