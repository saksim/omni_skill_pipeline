{
  "asset_id": "b1b4ae17-2be6-41e3-95a8-dff3adb964b3",
  "span_ref": "paragraph:0002",
  "content_type": "text",
  "content": "1. Capture the top slow queries from pg_stat_statements.\n2. Compare execution plans before changing indexes.",
  "speaker": null,
  "confidence": 0.86,
  "tags": [],
  "evidence_id": "acb02e36-bba9-4562-8267-3703a8954e24"
},
{
  "asset_id": "b1b4ae17-2be6-41e3-95a8-dff3adb964b3",
  "span_ref": "paragraph:0003",
  "content_type": "text",
  "content": "If the query is I/O bound, review the missing indexes first.\nAvoid adding overlapping indexes without measuring write amplification.\nVerify the new plan with EXPLAIN ANALYZE and compare latency.",
  "speaker": null,
  "confidence": 0.86,
  "tags": [],
  "evidence_id": "2d9d6d5a-fc8f-408b-a78c-130f8d84db8d"
}
