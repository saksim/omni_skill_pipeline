    "span_ref": "section:1:paragraph:0001",
    "content_type": "text",
    "content": "1. Capture the top slow queries from pg_stat_statements.\n2. Compare execution plans before changing indexes.",
    "speaker": null,
    "confidence": 0.86,
    "tags": [
      "section_path:1",
      "block:paragraph"
    ],
    "evidence_id": "a2dd12d7-c135-48e0-83ae-2f4124722a46"
